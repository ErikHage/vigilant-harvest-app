# Copy to spec/helpers/ui/.env.ui (gitignored) and fill in the password.
#
# The UI tests sign on as this user wherever a spec says `user: gardener`.
# It's the user vigilant-harvest-service's acceptance suite logs in as, made
# through feral's API (that suite's README says how) and granted the Vigilant
# Harvest application. It exists only in local databases, so a run that
# reached a live service would fail at login. Never put a real user here.
#
# Its password isn't in git. The service's test/acceptance/.env.acceptance
# holds the same one, as ACCEPTANCE_PASSWORD.

UI_GARDENER_USERNAME=vigilant-test-gardener
UI_GARDENER_PASSWORD=

# Optional. The defaults match ../start-vigilant-harvest.sh, and the
# application is the app's own VITE_APPLICATION_ID.
# UI_APP_URL=http://localhost:5174/apps/vigilant-harvest/
# UI_SERVICE_URL=http://localhost:8002/api/vigilant-harvest-service/v0
# UI_AUTH_SERVICE_URL=http://localhost:8003/api/feral-authentication-service/v0
# UI_AUTH_APP_URL=http://localhost:5173/auth/
# UI_APPLICATION_ID=82d7d287-978b-4df1-bc3d-526838b2465b
